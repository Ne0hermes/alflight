# Garde-fou charte design-tokens — bloque les NOUVELLES valeurs en dur
# (couleurs hex/rgba, noms de couleurs, px d'espacement/typo, fontWeight,
# fontFamily) sur les fichiers en cours de commit. Legacy non vérifié (boy-scout).
# Exception ponctuelle : // eslint-disable-next-line no-restricted-syntax
npm run lint:tokens:staged

# Garde-fou fallbacks/hard-coding — bloque les NOUVELLES occurrences (secrets en
# clair, fallbacks numériques métier, données aéro fictives, hooks debug) hors
# baseline figée (scripts/fallbacks-baseline.json). Exception : // fallback-ok
npm run lint:fallbacks:staged

# Garde-fou ANTI-SECRETS (Lot 0.2) — bloque tout commit contenant une clé API,
# une clé privée, un JWT ou un fichier .env/credentials stagé par erreur.
# Exception ponctuelle (faux positif) : « secret-ok » sur la ligne concernée.
npm run lint:secrets:staged
