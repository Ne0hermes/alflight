# ============================================================================
# ALFLIGHT — MODÈLE du fichier .env (copier vers `.env` et remplir)
# Un SEUL fichier de clés : D:\Applicator\alflight\.env  (jamais committé)
# ============================================================================

# --- Supabase (clé publique protégée par RLS) -------------------------------
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Météo AVWX (account.avwx.rest) -----------------------------------------
VITE_AVWX_API_KEY=

# --- Anthropic — analyse des manuels (console.anthropic.com) ----------------
VITE_ANTHROPIC_API_KEY=

# --- OpenAIP — espaces aériens, proxy serveur uniquement (openaip.net) ------
OPENAIP_API_KEY=
VITE_OPENAIP_PROXY_URL=http://localhost:3002
VITE_OPENAIP_USE_PROXY=true

# --- OpenAI (ancien analyseur, OPTIONNEL — laisser vide si non utilisé) -----
VITE_OPENAI_API_KEY=

# --- Clé Google Sheets (logger dev) : PAS ICI -------------------------------
# Fichier JSON de compte de service HORS du dépôt, chemin déclaré par la
# variable d'environnement Windows SHEETS_CREDENTIALS_PATH.
